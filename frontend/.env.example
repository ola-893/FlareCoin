# FlareYield Frontend Configuration
# Copy this file to .env and update with your deployed contract addresses

# Network Configuration
VITE_CHAIN_ID=114
VITE_NETWORK_NAME=Coston2
VITE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Core Protocol Contracts (Coston2 demo deployment)
VITE_PARENT_VAULT_ADDRESS=0x01f64160E4928Eba5607aE294F9B66090Dc323B3
VITE_FXRP_VAULT_ADDRESS=0x01f64160E4928Eba5607aE294F9B66090Dc323B3
# Required for the native-XRP route. Set this to the address emitted by
# DeployFdcDirectMintAdapter; do not use the retired watcher-driven adapter.
VITE_FASSET_ADAPTER_ADDRESS=
VITE_INSTRUCTION_SENDER_ADDRESS=0x94A838fb58B226b0EB01Fa8DdE3758806AcE1Ba7

# A stable, HTTPS public URL for the FCC extension proxy. Do not use localhost
# in a hosted build and do not expose any private key through a VITE_ variable.
VITE_FCE_ENDPOINT=https://your-fcc-result-proxy.example
# Native C2FLR wei forwarded with each FCC rebalance request (Coston2 default).
VITE_FCE_INSTRUCTION_FEE_WEI=1000000

# Token Addresses
VITE_FXRP_ADDRESS=0x0b6A3645c240605887a5532109323A3E12273dc7

# FAsset Infrastructure
VITE_ASSET_MANAGER_FXRP_ADDRESS=0xc1Ca88b937d0b528842F95d5731ffB586f4fbDFA
VITE_MINTING_TAG_MANAGER_ADDRESS=0x094511737909b626391106bBc21B25feb2D67B96
VITE_FDC_HUB_ADDRESS=0x48aC463d7975828989331F4De43341627b9c5f1D

# Explorer
VITE_EXPLORER_URL=https://coston2-explorer.flare.network

# Deployer Info (optional)
VITE_DEPLOYER_ADDRESS=0xYourDeployerAddress
